# 1. 파이썬 실행 캐시 찌꺼기 (올릴 필요 없음)
__pycache__/
*.pyc

# 2. PyInstaller 패키징 결과물 (용량 폭탄의 주범! 절대 올리면 안 됨)
build/
dist/
*.spec

# 3. 원본 로그 데이터 (개인정보 보호를 위해 실제 카톡 텍스트는 빼고 올려야 함)
data/raw/*.txt
data/raw/*.csv
data/raw/*.exe

# 4. 가상환경 및 환경변수 설정 파일 (내 컴퓨터에서만 쓰는 설정)
venv/
env/
.env

# 5. (선택) 인공지능 가중치 파일 
# 현재는 용량이 작아서 올려도 되지만, 나중에 모델이 몇 GB 단위로 커지면 아래 주석을 풉니다.
# models/**/*.pt