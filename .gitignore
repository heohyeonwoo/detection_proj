.venv/
__pycache__/

# 🚨 무거운 AI 체크포인트 및 모델 폴더 (어디에 있든 무조건 차단)
**/final_context_model/
**/final_jun_context_model/
**/koelectra_slang_hunter_v3/
**/checkpoint-*/
**/models/
**/tmp_checkpoints/

# 🚨 학습 부산물 및 가중치 파일들 (이름까지 직접 저격)
*.safetensors
*.pt
*.pth
*.bin
optimizer.pt
rng_state.pth
scheduler.pt
trainer_state.json
training_args.bin

# 🚨 데이터셋
**/data/
*.csv
*.xlsx

# 기타 쓰레기 파일
.DS_Store
.vscode/
EOF
# 1. 파이썬 실행 캐시 찌꺼기
__pycache__/
*.pyc
*.py[cod]
*$py.class

# 2. PyInstaller 패키징 결과물 
build/
dist/
*.spec

# 3. 데이터 폴더 및 CSV/캐시 파일 (보안 데이터, 깃허브 업로드 절대 금지)
data/
*.csv
normal_data_cache*.csv

# 4. 가상환경 및 환경변수 설정 파일 
venv/
env/
.env

# 5. 무거운 딥러닝 모델 폴더 및 훈련 로그 (업로드 시 깃허브 서버 터짐)
my_trained_model/
FINAL_INVESTIGATION_MODEL/
final_context_*/
koelectra_slang_hunter_v3/
